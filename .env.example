# ---------------------------------------------------------------------------
# LMAA Family App — environment configuration
#
# Copy this file to `.env.local` for local development.
# `.env.local` is git-ignored and must never be committed.
#
# EVERYTHING in this file ends up inside the JavaScript that runs in a
# family's browser. Anything you put here is PUBLIC.
#   -> Browser-safe:  the Supabase project URL and the publishable/anon key
#   -> NEVER put here: the Supabase secret (service_role) key, a OneSignal
#      REST API key, a database password, or any other true secret.
# ---------------------------------------------------------------------------

# Where the app is hosted.
#   "/lmaa-app/"  -> GitHub Pages project site (https://USER.github.io/lmaa-app/)
#   "/"           -> custom domain or local development
# GitHub Actions sets this automatically during deployment.
VITE_BASE_PATH=/

# ---------------------------------------------------------------------------
# Supabase (optional)
# Leave both blank to run the app in demo mode with built-in seed content.
# Fill both in to switch the app over to real, editable content.
# ---------------------------------------------------------------------------
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# ---------------------------------------------------------------------------
# Feature flags (optional). "true" / "false".
# ---------------------------------------------------------------------------

# Leadership Academy module — not built yet, keep false.
VITE_FEATURE_LEADERSHIP=false

# --- Push notifications -----------------------------------------------------
# Full walkthrough: PUSH_NOTIFICATIONS_SETUP.md
#
# The VAPID PUBLIC key. Safe to publish — it is meant to be in the browser.
# Generate a pair with:  npx web-push generate-vapid-keys
# The PRIVATE key of that pair must NEVER appear here or in any VITE_ variable;
# it belongs in Supabase:  supabase secrets set VAPID_PRIVATE_KEY=...
# Setting this alone lets families subscribe.
VITE_VAPID_PUBLIC_KEY=

# The deployed sender, e.g.
# https://YOUR-PROJECT.supabase.co/functions/v1/send-notification
# Until this is set the admin Send button stays disabled, so nothing can look
# like it was delivered when it was not.
VITE_PUSH_FUNCTION_URL=

# Optional: shown on the More screen so families can report the version they see.
VITE_APP_VERSION=
